{
    "name": "croox/statamic-ai-alt",
    "description": "AI-powered alt text generation for Statamic assets (OpenAI, Claude, Gemini)",
    "type": "statamic-addon",
    "autoload": {
        "psr-4": {
            "Croox\\StatamicAiAlt\\": "src"
        }
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0",
        "laravel/ai": "^1.3"
    },
    "extra": {
        "statamic": {
            "name": "Statamic AI Alt",
            "description": "AI-powered alt text generation"
        },
        "laravel": {
            "providers": [
                "Croox\\StatamicAiAlt\\ServiceProvider"
            ]
        }
    },
    "license": "MIT"
}
